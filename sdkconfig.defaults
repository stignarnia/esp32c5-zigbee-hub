# esp32c5-zigbee-hub — build defaults
#
# Changing this file does NOT update an existing ./sdkconfig. After editing:
#   rm -rf sdkconfig build && idf.py build
# then check build/config/sdkconfig.h.

CONFIG_IDF_TARGET="esp32c5"

# --- Flash: 16 MB, custom partition table --------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The bootloader can only be updated over serial, so its features are fixed
# from day one: A/B rollback for OTA updates from the web UI.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- CPU / RTOS -----------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# --- PSRAM: 8 MB embedded, quad --------------------------------------------
# Internal RAM (~320 KB) is the bottleneck on this chip; PSRAM is where large
# buffers go. Thresholds below are the ones the reference repo ran stably with
# on the same chip; revisit with measurements once Zigbee + Wi-Fi are up.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# The boot-time PSRAM self-test cost ~1 s per boot (measured). Boot time matters
# for the watchdog/OTA reboot gap; the chip's PSRAM passed it on every boot so far.
CONFIG_SPIRAM_MEMTEST=n

# --- Network ---------------------------------------------------------------
# Re-request the last DHCP lease (stored in NVS) instead of a full DISCOVER.
CONFIG_LWIP_DHCP_RESTORE_LAST_IP=y
# The default ARP probe of the offered address cost ~1 s per connect (measured).
# The router's DHCP server already owns the address pool.
CONFIG_LWIP_DHCP_DOES_NOT_CHECK_OFFERED_IP=y

# --- Logging ----------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y

# --- Web UI -------------------------------------------------------------------
CONFIG_HTTPD_WS_SUPPORT=y
# Auth runs before the WebSocket upgrade (IDF 6.1 skips the handler on handshake).
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y
# Room for the web UI (httpd default 7 slots + 3 internal), mDNS, SNTP, and later
# Tailscale and the ESPHome API (default 10).
CONFIG_LWIP_MAX_SOCKETS=24

# Wi-Fi event handlers log, and every log line also passes through the on-board
# log hook: give the system event task headroom (default 2304).
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# --- Zigbee (esp-zigbee-lib 2.x, native 802.15.4 radio, coordinator) ----------
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZCZR=y
CONFIG_ZB_RADIO_NATIVE=y

# --- Crash diagnosis without a serial cable ------------------------------------
# A panic writes an ELF core dump to the `coredump` partition; the next boot logs
# task/PC/RA into the on-board log and /api/coredump serves the full dump.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# --- Tailscale (components/tailscale, microlink port) ---------------------------
# The control-plane Noise channel is ChaCha20-Poly1305 via PSA.
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
# The WireGuard netif keeps its device in an lwIP client-data slot: ESP-IDF reads
# netif->state of every netif as its own esp_netif_t (crashed on netif_add).
CONFIG_LWIP_NUM_NETIF_CLIENT_DATA=1
# WireGuard runs partly in its own task: every call into it (and into lwIP's raw API)
# from there holds the lwIP core lock. The safety check asserts on any lwIP call made
# from the wrong context, so a mistake fails loudly instead of corrupting memory.
CONFIG_LWIP_TCPIP_CORE_LOCKING=y
CONFIG_LWIP_CHECK_THREAD_SAFETY=y
# mbedTLS buffers in PSRAM (memory lever 3). Measured with Tailscale up: internal heap
# lowest 15 KB with them internal (DERP TLS session). IDF's warning about PSRAM on rev
# v1.0 only matters with flash encryption, which this project doesn't use.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# No IPv6 (2026-11-07): nothing on the hub uses it (no SLAAC, microlink is IPv4-only;
# the direct path to a same-ISP peer came from NAT-PMP instead). Measured cost when on: 43.6 KB
# flash, 2.0 KB static internal RAM. Turning it back on also needs IPv6 in microlink.
CONFIG_LWIP_IPV6=n
